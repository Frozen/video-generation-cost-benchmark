# Copy to ignored .env.local and restrict its permissions to the owner.
# Never put real secrets in this tracked example, Git commits or chat.
# scripts/check_access.py loads a file explicitly using --env-file.
# Existing FAL_API and RUNPOD_API names are also accepted; do not duplicate values.
FAL_KEY=
RUNPOD_API_KEY=
# LTX-2.5 requires model-page access approval and a read-scoped Hugging Face token.
HF_TOKEN=
